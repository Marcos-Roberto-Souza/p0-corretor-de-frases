"""
                    ----    INSTRUÇÕES     -------
Copie este arquivo para ".env" e ajuste os valores.
O arquivo ".env" fica fora do Git. Nunca coloque dados reais neste exemplo.
"""
# Endereço do servidor Ollama (precisa começar com http:// ou https://)
OLLAMA_HOST=http://localhost:11434

# Modelo usado nas correções
OLLAMA_MODEL=llama3.2

# Tempo limite de cada chamada, em segundos
OLLAMA_TIMEOUT=60

# Verificar o certificado SSL do servidor (use false só para certificaddo auto assinado que é o exemplo usando no curso)
OLLAMA_VERIFY_SSL=true

#Só se o servidor exigir autenticação insira a chave da api Key ( ou deixe vazio caso contrário )
OLLAMA_API_KEY=
